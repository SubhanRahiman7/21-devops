#!/bin/bash
# Installs Docker and starts the Task Tracker container from the ECR repository.
set -euxo pipefail
dnf install -y docker
systemctl enable --now docker

aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}

mkdir -p /var/lib/task-tracker && chown 10001:10001 /var/lib/task-tracker
docker run -d --name task-tracker --restart unless-stopped \
  -p 80:8080 \
  -e APP_ENV=production \
  -e API_TOKEN="$(openssl rand -hex 16)" \
  -v /var/lib/task-tracker:/data \
  ${image}
